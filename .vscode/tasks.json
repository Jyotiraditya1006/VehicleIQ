{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run FastAPI Backend API",
      "type": "shell",
      "command": "uvicorn backend.app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "2. Run Next.js Web Dashboard",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🚀 Start Full VehicleIQ System",
      "dependsOn": [
        "1. Run FastAPI Backend API",
        "2. Run Next.js Web Dashboard"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
