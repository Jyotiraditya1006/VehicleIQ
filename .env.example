# VehicleIQ Configuration Template

ENVIRONMENT=development

# Database Settings ('sqlite' or 'postgres')
DB_TYPE=sqlite
SQLITE_DB_PATH=vehicleiq_dev.db

# PostgreSQL (used when DB_TYPE=postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vehicleiq

# Ingestion Settings ('simulation' or 'live')
INGESTION_MODE=simulation
OBD_PORT=COM3
OBD_BAUDRATE=38400

# Sampling Settings
SAMPLE_INTERVAL_SEC=1.0
BATCH_SIZE=10
